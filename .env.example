# Required database connection
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Required in production for signed administrator sessions
JWT_SECRET=replace-with-a-long-random-secret

# Used only to create the first administrator when the users table is empty
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional runtime configuration
PORT=5000
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
