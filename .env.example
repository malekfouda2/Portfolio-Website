# Required database connection
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Required in production for signed administrator sessions
JWT_SECRET=replace-with-a-long-random-secret

# Used only to create the first administrator when the users table is empty
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional runtime configuration
PORT=5000
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Lead email delivery (verify the FROM domain in Resend)
RESEND_API_KEY=re_xxxxxxxxx
LEAD_FROM_EMAIL=Malek Fouda <leads@mail.malekfouda.com>
LEAD_NOTIFICATION_TO=malekfouda2000@gmail.com

# Contact-form bot protection; configure both values together
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
